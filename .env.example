# Только параметры запуска контейнеров. Рабочие настройки задаются в Web UI.
POSTGRES_DB=archiver
POSTGRES_USER=archiver
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://archiver:change-me@db:5432/archiver
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=replace-with-fernet-key
NAS_MOUNT_PATH=./nas

